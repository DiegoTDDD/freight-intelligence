FROM python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    POLARS_MAX_THREADS=2 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /app
COPY requirements/api-linux-py313.lock ./requirements/api-linux-py313.lock
RUN --mount=type=cache,target=/root/.cache/pip python -m pip install -r requirements/api-linux-py313.lock
COPY pyproject.toml README.md ./
COPY freight_intelligence ./freight_intelligence
COPY deployment/preview_data ./deployment/preview_data
COPY deployment/brazil_modes ./deployment/brazil_modes
COPY deployment/brazil_modal_forecasts ./deployment/brazil_modal_forecasts
COPY deployment/brazil_gas ./deployment/brazil_gas
COPY deployment/brazil_water ./deployment/brazil_water
COPY deployment/brazil_road ./deployment/brazil_road
COPY deployment/brazil_air ./deployment/brazil_air
COPY deployment/brazil_gas_history ./deployment/brazil_gas_history
COPY deployment/trip_planning ./deployment/trip_planning
COPY deployment/duty_review ./deployment/duty_review
RUN python -m pip install --no-deps -e ".[api]" && python -m pip check \
    && python -m freight_intelligence.utils.runtime_lock
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=2)"
CMD ["python", "-m", "uvicorn", "freight_intelligence.public_api:app", "--host", "0.0.0.0", "--port", "8000"]
